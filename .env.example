# Copy to .env (git-ignored). Read by the backend only; never exposed to the browser.

# Leave empty to run on the mock provider.
ANTHROPIC_API_KEY=

# Model used when a key is set (default: claude-haiku-5-5, small and fast).
ANTHROPIC_MODEL=

# Only for an API key that is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Host port for the UI (default 3000).
UI_PORT=3000

# Set to true to serve interactive API docs at /api/docs. Never in production.
DEV_MODE=
